
<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <input>
    <net-file value="../../../network/dokki.net.xml"/>
    <route-files value="../../../simulation/dokki_random.rou.xml"/>
    <additional-files value="../../../simulation/traffic_lights.add.xml,../../../simulation/hospitals.add.xml,ambulance.add.xml"/>
</input>
    <time>
        <begin value="0"/>
        <end value="600"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="-1"/>
        <collision.action value="warn"/>
        <collision.check-junctions value="true"/>
    </processing>

    <report>
        <seed value="1"/>
        <no-step-log value="true"/>
    </report>
</configuration>

